[Unit]
Description=FTOF HV monitor (tmux session ftof)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/misc/share /home/sks/.venv /home/sks/monitor_tools/CVC_hv_monitoring

[Service]
Type=oneshot
RemainAfterExit=yes
User=sks
WorkingDirectory=/home/sks/monitor_tools/CVC_hv_monitoring
ExecStartPre=/usr/bin/test -r /home/sks/monitor_tools/CVC_hv_monitoring/monitor_caen.py
ExecStartPre=/usr/bin/test -r /home/sks/monitor_tools/CVC_hv_monitoring/param/conf.yml
ExecStart=/usr/bin/bash /home/sks/monitor_tools/CVC_hv_monitoring/start.sh
ExecStop=/usr/bin/bash /home/sks/monitor_tools/CVC_hv_monitoring/start.sh --stop
Restart=no
KillSignal=SIGINT
# The tmux server can be shared with BLC/HV3/HV4; stop only the ftof session.
KillMode=process
TimeoutStopSec=30
SuccessExitStatus=130
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
