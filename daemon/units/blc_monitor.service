[Unit]
Description=BLC HV monitor (tmux session blc)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/misc/share /home/sks/.venv /home/sks/monitor_tools/BLC_hv_monitoring

[Service]
Type=oneshot
RemainAfterExit=yes
User=sks
WorkingDirectory=/home/sks/monitor_tools/BLC_hv_monitoring
ExecStartPre=/usr/bin/test -r /home/sks/monitor_tools/BLC_hv_monitoring/monitor_caen.py
ExecStartPre=/usr/bin/test -r /home/sks/monitor_tools/BLC_hv_monitoring/param/conf.yml
ExecStart=/usr/bin/bash /home/sks/monitor_tools/BLC_hv_monitoring/start.sh
ExecStop=/usr/bin/bash /home/sks/monitor_tools/BLC_hv_monitoring/start.sh --stop
Restart=no
KillSignal=SIGINT
# The tmux server can be shared with other monitors; stop only the blc session.
KillMode=process
TimeoutStopSec=30
SuccessExitStatus=130
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
